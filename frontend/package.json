{
  "name": "factorio-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "ajv": "^6.15.0",
    "pako": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^13.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "npm run test:unit && npm run test:node",
    "test:unit": "vitest run",
    "test:node": "node --test cli.test.mjs validator/validate.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "npm run test:unit -- --coverage && npm run test:node:coverage",
    "test:node:coverage": "mkdir -p coverage-node && node --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage-node/lcov.info --test cli.test.mjs validator/validate.test.mjs",
    "preview": "vite preview"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "description": "Plan Factorio production lines from output targets, input limits, and machine constraints. Preview and export blueprints in the browser.",
  "homepage": "https://afloresescarcega.github.io/factorio-router/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afloresescarcega/factorio-router.git",
    "directory": "frontend"
  }
}
